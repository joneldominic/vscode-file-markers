{
  "name": "file-markers",
  "displayName": "File Markers",
  "description": "Track file and folder status directly in VSCode's Explorer. Right-click to add visual markers like Done, In Progress, or Pending—no config files to edit, no separate sidebar to manage. Perfect for migrations, refactoring projects, and code reviews. Markers persist in .vscode/file-markers.json for easy team sharing.",
  "version": "1.6.0",
  "publisher": "joneldominic-dev",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "file",
    "marker",
    "badge",
    "explorer",
    "status",
    "tracking",
    "migration",
    "refactoring",
    "productivity",
    "workflow"
  ],
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joneldominic/vscode-file-markers"
  },
  "homepage": "https://github.com/joneldominic/vscode-file-markers#readme",
  "bugs": {
    "url": "https://github.com/joneldominic/vscode-file-markers/issues"
  },
  "license": "MIT",
  "pricing": "Free",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "file-markers.setMarker",
        "title": "File Markers: Set Marker..."
      },
      {
        "command": "file-markers.removeMarker",
        "title": "File Markers: Remove Marker"
      },
      {
        "command": "file-markers.removeMarkersInFolder",
        "title": "File Markers: Remove Markers in Folder"
      },
      {
        "command": "file-markers.removeAllMarkers",
        "title": "File Markers: Remove All Markers"
      },
      {
        "command": "file-markers.toggleMarker",
        "title": "File Markers: Toggle Marker on Current File"
      },
      {
        "command": "file-markers.openConfig",
        "title": "File Markers: Open Configuration"
      },
      {
        "command": "file-markers.showMarkerStats",
        "title": "File Markers: Show Marker Statistics"
      },
      {
        "command": "file-markers.toggleEnabled",
        "title": "File Markers: Toggle Enable/Disable"
      },
      {
        "command": "file-markers.setLineHighlight",
        "title": "File Markers: Set Line Highlight..."
      },
      {
        "command": "file-markers.removeLineHighlight",
        "title": "File Markers: Remove Line Highlight"
      },
      {
        "command": "file-markers.removeAllLineHighlightsInFile",
        "title": "File Markers: Remove All Line Highlights in File"
      },
      {
        "command": "file-markers.toggleLineHighlight",
        "title": "File Markers: Toggle Line Highlight"
      },
      {
        "command": "file-markers.removeAllLineHighlights",
        "title": "File Markers: Remove All Line Highlights"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "file-markers.setMarker",
          "group": "2_workspace@1",
          "when": "config.fileMarkers.enabled"
        },
        {
          "command": "file-markers.removeMarker",
          "group": "2_workspace@2",
          "when": "config.fileMarkers.enabled"
        },
        {
          "command": "file-markers.removeMarkersInFolder",
          "group": "2_workspace@3",
          "when": "explorerResourceIsFolder && config.fileMarkers.enabled"
        }
      ],
      "editor/title/context": [
        {
          "command": "file-markers.setMarker",
          "group": "3_fileMarkers@1",
          "when": "config.fileMarkers.enabled"
        },
        {
          "command": "file-markers.removeMarker",
          "group": "3_fileMarkers@2",
          "when": "config.fileMarkers.enabled"
        }
      ],
      "editor/context": [
        {
          "command": "file-markers.setLineHighlight",
          "group": "9_fileMarkers@1",
          "when": "config.fileMarkers.enabled && editorHasSelection"
        },
        {
          "command": "file-markers.removeLineHighlight",
          "group": "9_fileMarkers@2",
          "when": "config.fileMarkers.enabled && editorHasSelection"
        },
        {
          "command": "file-markers.removeAllLineHighlightsInFile",
          "group": "9_fileMarkers@3",
          "when": "config.fileMarkers.enabled"
        }
      ],
      "commandPalette": [
        {
          "command": "file-markers.setMarker",
          "when": "false"
        },
        {
          "command": "file-markers.removeMarker",
          "when": "false"
        },
        {
          "command": "file-markers.removeMarkersInFolder",
          "when": "false"
        },
        {
          "command": "file-markers.removeAllMarkers"
        },
        {
          "command": "file-markers.toggleMarker"
        },
        {
          "command": "file-markers.openConfig"
        },
        {
          "command": "file-markers.showMarkerStats"
        },
        {
          "command": "file-markers.toggleEnabled"
        },
        {
          "command": "file-markers.setLineHighlight",
          "when": "editorHasSelection"
        },
        {
          "command": "file-markers.removeLineHighlight",
          "when": "editorHasSelection"
        },
        {
          "command": "file-markers.removeAllLineHighlightsInFile",
          "when": "editorIsOpen"
        },
        {
          "command": "file-markers.toggleLineHighlight",
          "when": "editorIsOpen"
        },
        {
          "command": "file-markers.removeAllLineHighlights"
        }
      ]
    },
    "keybindings": [
      {
        "command": "file-markers.toggleMarker",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus"
      },
      {
        "command": "file-markers.toggleLineHighlight",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "File Markers",
      "properties": {
        "fileMarkers.inheritFolderMarkers": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, unmarked files inside a marked folder will display a dimmed version of the folder's marker."
        },
        "fileMarkers.statusBarAlignment": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left",
          "description": "Position of the marker statistics in the status bar."
        },
        "fileMarkers.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable File Markers. When disabled, markers are hidden but preserved."
        }
      }
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "vsix": "pnpm run package && vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:coverage": "c8 vscode-test"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.74.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "c8": "^10.1.3",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "lefthook": "^2.0.16",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  }
}
